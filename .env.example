# Local static scanning does not require environment variables.
# Keep real credentials in a secret manager; never commit a populated .env file.

# Platform database (PostgreSQL only)
CLOUDSENTRY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cloudsentry

# OIDC resource-server configuration (see docs/oidc-platform-api.md)
CLOUDSENTRY_OIDC_ISSUER=
CLOUDSENTRY_OIDC_AUDIENCE=
CLOUDSENTRY_OIDC_JWKS_URL=

# GitHub App integration (see docs/github-app-integration.md)
CLOUDSENTRY_GITHUB_APP_ID=
# Supply PEM private key contents; escaped newlines are supported.
CLOUDSENTRY_GITHUB_APP_PRIVATE_KEY=
# Use a randomly generated secret of at least 32 characters.
CLOUDSENTRY_GITHUB_WEBHOOK_SECRET=

# Private worker-to-executor authentication.
# Set the same random value in the worker and executor environments.
# Do not expose this secret to the API, dashboard, repository, or logs.
CLOUDSENTRY_EXECUTOR_SHARED_SECRET=
# The client currently accepts only the private Docker service endpoint below.
CLOUDSENTRY_EXECUTOR_URL=http://scan-executor:8081/internal/v1/scan

# Worker process settings.
CLOUDSENTRY_WORKER_ID=
CLOUDSENTRY_WORKER_POLL_SECONDS=2
CLOUDSENTRY_WORKER_LEASE_SECONDS=900
CLOUDSENTRY_LOG_LEVEL=INFO
